<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Google Drive Links</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
            min-height: 100vh;
            color: #e2e8f0;
            padding: 40px 20px;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        header {
            text-align: center;
            margin-bottom: 50px;
        }

        header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            background: linear-gradient(135deg, #60a5fa, #a78bfa, #f472b6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 12px;
        }

        header p {
            color: #94a3b8;
            font-size: 1.1rem;
        }

        .stats {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-bottom: 40px;
        }

        .stat-item {
            background: rgba(30, 41, 59, 0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(100, 116, 139, 0.3);
            border-radius: 16px;
            padding: 20px 30px;
            text-align: center;
            min-width: 140px;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            color: #60a5fa;
        }

        .stat-label {
            font-size: 0.85rem;
            color: #94a3b8;
            margin-top: 4px;
        }

        .search-box {
            position: relative;
            margin-bottom: 30px;
        }

        .search-box input {
            width: 100%;
            padding: 16px 20px 16px 50px;
            background: rgba(30, 41, 59, 0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(100, 116, 139, 0.3);
            border-radius: 16px;
            color: #e2e8f0;
            font-size: 1rem;
            font-family: 'Inter', sans-serif;
            transition: all 0.3s ease;
        }

        .search-box input:focus {
            outline: none;
            border-color: #60a5fa;
            box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.2);
        }

        .search-box input::placeholder {
            color: #64748b;
        }

        .search-icon {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
        }

        .links-grid {
            display: grid;
            gap: 16px;
        }

        .link-card {
            background: rgba(30, 41, 59, 0.5);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(100, 116, 139, 0.2);
            border-radius: 16px;
            padding: 20px 24px;
            display: flex;
            align-items: center;
            gap: 16px;
            transition: all 0.3s ease;
            cursor: pointer;
            text-decoration: none;
            color: inherit;
            animation: fadeInUp 0.5s ease forwards;
            opacity: 0;
        }

        .link-card:hover {
            background: rgba(51, 65, 85, 0.6);
            border-color: rgba(96, 165, 250, 0.4);
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
        }

        .link-card:active {
            transform: translateY(0);
        }

        .link-card.hidden {
            display: none;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .link-icon {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, #3b82f6, #6366f1);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .link-icon svg {
            width: 24px;
            height: 24px;
            fill: white;
        }

        .link-info {
            flex: 1;
            min-width: 0;
        }

        .link-title {
            font-weight: 600;
            font-size: 1rem;
            color: #f1f5f9;
            margin-bottom: 4px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .link-id {
            font-size: 0.8rem;
            color: #64748b;
            font-family: monospace;
        }

        .link-arrow {
            color: #64748b;
            transition: all 0.3s ease;
            flex-shrink: 0;
        }

        .link-card:hover .link-arrow {
            color: #60a5fa;
            transform: translateX(4px);
        }

        .no-results {
            text-align: center;
            padding: 60px 20px;
            color: #64748b;
            display: none;
        }

        .no-results.visible {
            display: block;
        }

        .no-results svg {
            width: 64px;
            height: 64px;
            margin-bottom: 16px;
            opacity: 0.5;
        }

        footer {
            text-align: center;
            margin-top: 60px;
            padding: 20px;
            color: #475569;
            font-size: 0.85rem;
        }

        @media (max-width: 640px) {
            header h1 {
                font-size: 1.8rem;
            }

            .stats {
                gap: 12px;
            }

            .stat-item {
                padding: 14px 18px;
                min-width: 100px;
            }

            .stat-number {
                font-size: 1.5rem;
            }

            .link-card {
                padding: 16px;
            }

            .link-icon {
                width: 40px;
                height: 40px;
                border-radius: 10px;
            }

            .link-icon svg {
                width: 20px;
                height: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>📁 Google Drive Files</h1>
            <p>Bộ sưu tập tài liệu trên Google Drive</p>
        </header>

        <div class="stats">
            <div class="stat-item">
                <div class="stat-number" id="totalCount">18</div>
                <div class="stat-label">Tổng số link</div>
            </div>
            <div class="stat-item">
                <div class="stat-number" id="filteredCount">18</div>
                <div class="stat-label">Hiển thị</div>
            </div>
        </div>

        <div class="search-box">
            <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
            </svg>
            <input type="text" id="searchInput" placeholder="Tìm kiếm link..." />
        </div>

        <div class="links-grid" id="linksGrid"></div>

        <div class="no-results" id="noResults">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
                <path d="M8 11h6"></path>
            </svg>
            <p>Không tìm thấy kết quả nào</p>
        </div>

        <footer>
            <p>Nhấp vào bất kỳ link nào để mở trên Google Drive</p>
        </footer>
    </div>

    <script>
        const driveLinks = [
            { id: '1-8tNC9IO4ASz2vqN2zZLECqpchxJhdJK' },
            { id: '14-tii2oXNZ3WQwrTEZ6vlFMcSAzroRZ7' },
            { id: '1DgmmwI3cg1YMOEh-W9K1d-_4LS7-YqOz' },
            { id: '1Qnq6MAchTT28sHoiWWlBcoYQu_-nyI0Q' },
            { id: '1W94UCOEq8S4_ZfLW2yVlSJCPYos98GUF' },
            { id: '1XmvQ8LTS50fD-Rdr3gwSe54TmyXdtf3c' },
            { id: '1aRGri0b5n3-6dlKalgF-IRwjD6dLEm8X' },
            { id: '1bXdEz--nQJ9lrns3pq7Ow3JfJQ-yymvh' },
            { id: '1bpBnWaDucQjg6YUZ5O8ScjX7xErncV7U' },
            { id: '1cKjYJUPBfaN-jqzUFRUMhrCv95-J0xcx' },
            { id: '1ekBVuqU_QJh1j4-EHHm35H6I0EydMnDX' },
            { id: '1jW8cF3WIRAq0DhDoVDHFzZRMHfpO-QxE' },
            { id: '1n0WIYfHquyIPKbK1E3sCOLAVsEeSADjX' },
            { id: '1nsAMGlTc8LuUW36up4I1r3Z7IUkdSQoX' },
            { id: '1tDKvPdsVk5Iq4U8dIcZee_PSQq5pKFiw' },
            { id: '1x7OuJm99ThWkALKbKYbuoodgzmw0nJ9t' },
            { id: '1xj9VgXeKvj0Mdj82WcUDKPrkaxv5WevF' },
            { id: '1yirlx6UrOo2JI1lMErMLcMzP64x1qF6h' }
        ];

        const grid = document.getElementById('linksGrid');
        const searchInput = document.getElementById('searchInput');
        const filteredCount = document.getElementById('filteredCount');
        const noResults = document.getElementById('noResults');

        function createLinkCard(item, index) {
            const url = `https://drive.google.com/file/d/${item.id}/view?usp=sharing`;
            const card = document.createElement('a');
            card.className = 'link-card';
            card.href = url;
            card.target = '_blank';
            card.rel = 'noopener noreferrer';
            card.style.animationDelay = `${index * 0.05}s`;

            card.innerHTML = `
                <div class="link-icon">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm4 18H6V4h7v5h5v11z"/>
                        <path d="M8 13h8v2H8zm0 4h5v2H8z"/>
                    </svg>
                </div>
                <div class="link-info">
                    <div class="link-title">Tài liệu ${index + 1}</div>
                    <div class="link-id">ID: ${item.id}</div>
                </div>
                <div class="link-arrow">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"></path>
                        <path d="m12 5 7 7-7 7"></path>
                    </svg>
                </div>
            `;

            return card;
        }

        function renderLinks(filterText = '') {
            grid.innerHTML = '';
            let count = 0;
            const lowerFilter = filterText.toLowerCase();

            driveLinks.forEach((item, index) => {
                const title = `Tài liệu ${index + 1}`;
                const searchStr = `${title} ${item.id}`.toLowerCase();

                if (lowerFilter && !searchStr.includes(lowerFilter)) {
                    return;
                }

                grid.appendChild(createLinkCard(item, count));
                count++;
            });

            filteredCount.textContent = count;
            noResults.classList.toggle('visible', count === 0);
        }

        searchInput.addEventListener('input', (e) => {
            renderLinks(e.target.value.trim());
        });

        renderLinks();
    </script>
</body>
</html>

